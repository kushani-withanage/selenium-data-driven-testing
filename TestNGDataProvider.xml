<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="Login Suite with data provider">
    <!--        This is from extentreports-testng-adapter dependency-->
    <listeners>
        <listener class-name="com.aventstack.extentreports.testng.listener.ExtentITestListenerClassAdapter"/>
    </listeners>

    <test name="data provider">
        <classes>
            <class name="DataDrivenTest.LoginUsingDataProvider"/>
        </classes>
    </test>

</suite>
